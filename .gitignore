# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated at build time (predev/prebuild) from content/documents/*.yaml and
# content/pages/*.yaml — see scripts/generate-documents.mjs and scripts/generate-pages.mjs.
# Not the source of truth; do not hand-edit or commit.
/src/lib/documents.generated.json
/src/lib/pages.generated.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
